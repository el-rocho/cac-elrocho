# Configuración de la aplicación cac-elrocho
APP_ENV=production
PORT=8000
HOST=0.0.0.0

# Base de datos SQLite
DATABASE_URL=sqlite:////app/data/analiticas.db

# Rutas de almacenamiento
DATA_DIR=/app/data
INBOX_DIR=/app/inbox

# Proveedor de Inteligencia Artificial (LLM)
# Opciones: gemini (Recomendado Opción A) o mock (para pruebas locales sin API key)
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_clave_de_gemini_api_aqui
GEMINI_MODEL=gemini-3.6-flash

# Seguridad básica (opcional para acceso web)
AUTH_ENABLED=false
ADMIN_USERNAME=javier
ADMIN_PASSWORD=cambia_esta_contraseña_segura
SECRET_KEY=genera_una_clave_aleatoria_para_sesiones
