# Configuración de la aplicación cac-elrocho
APP_ENV=production
PORT=8000
HOST=0.0.0.0

# Raíz de datos persistentes. En Docker coincide con los volúmenes /app/*.
# En desarrollo desde el repositorio puede omitirse para conservar la estructura actual.
APP_DATA_DIR=/app

# Compatibilidad temporal: DATABASE_URL, DATA_DIR e INBOX_DIR continúan
# aceptándose, pero APP_DATA_DIR es la configuración recomendada.

# Configuración de IA administrada por el entorno (opcional).
# Déjala comentada para configurarla desde la interfaz; una clave de entorno
# tiene prioridad y bloquea los controles equivalentes de la aplicación.
# LLM_PROVIDER1=gemini
# API_KEY1=tu_clave_de_gemini_api_aqui
# MODEL1=gemini-2.5-flash

# Seguridad básica (opcional para acceso web)
AUTH_ENABLED=false
ADMIN_USERNAME=javier
ADMIN_PASSWORD=cambia_esta_contraseña_segura
SECRET_KEY=genera_una_clave_aleatoria_para_sesiones

# Orígenes permitidos para peticiones cruzadas, separados por comas.
# La interfaz servida por esta aplicación no necesita CORS.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
